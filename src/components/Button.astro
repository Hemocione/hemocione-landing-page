---
interface Props {
    size?: "small" | "medium";
    type?: "primary" | "secondary" | "plain";
    className?: string;
    href?: string;
    target?: string;
    rel?: string;
    "aria-label"?: string;
}

const { type = "primary", size, className = "", href, ...attrs } = Astro.props;
const Tag = href ? "a" : "button";
---

<Tag href={href} class:list={["btn", type, size, className]} {...attrs}>
    <slot />
</Tag>

<style>
    .btn {
        display: inline-block;
        box-sizing: border-box;
        padding: 1rem 3rem;
        border-radius: 0.5rem;
        cursor: pointer;
        font-size: 1rem;
        font-weight: 600;
        line-height: 1;
        text-align: center;
        border: 1px solid transparent;
        transition:
            background-color 0.2s,
            border-color 0.2s;
    }

    .btn:focus-visible {
        outline: 2px solid var(--hemo-color-primary);
        outline-offset: 2px;
    }

    .secondary {
        background-color: var(--hemo-color-secondary);
        color: var(--hemo-color-text-secondary);
    }

    .secondary:hover {
        background-color: var(--hemo-color-secondary-dark);
    }

    .primary {
        background-color: var(--hemo-color-primary);
        color: white;
    }

    .primary:hover {
        background-color: var(--hemo-color-primary-dark);
    }

    .plain {
        background-color: transparent;
        color: var(--hemo-color-primary);
    }

    .plain:hover {
        border: 1px solid var(--hemo-color-primary);
    }

    .small {
        padding: 0.5rem 1.5rem;
        font-size: 1rem;
    }
</style>
