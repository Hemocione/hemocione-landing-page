---
import Collapse from "../Collapse.astro";
import faqWEBP from "../../assets/home/faq.webp";

const FAQ_ITEMS = [
  {
    q: "O que é o Hemocione?",
    a: "O Hemocione é uma ONG brasileira, fundada em 2017, que promove a doação de sangue no Brasil. A organização conecta doadores, hemocentros parceiros e instituições através de eventos, uma plataforma digital e campanhas de conscientização.",
  },
  {
    q: "Como posso doar sangue pelo Hemocione?",
    a: "Você pode participar de um evento de doação organizado pelo Hemocione ou usar a ferramenta \"Onde Doar\" para encontrar o hemocentro mais próximo. Antes de doar, use \"Descubra se você pode doar\" para checar sua elegibilidade.",
  },
  {
    q: "Como uma empresa pode organizar uma campanha de doação de sangue?",
    a: "Sua empresa pode usar o serviço \"Leve uma Coleta\" para trazer um hemocentro parceiro até o seu escritório. Veja o passo a passo completo na página Leve uma Coleta para sua Empresa.",
  },
  {
    q: "Organizar uma coleta na minha empresa tem algum custo?",
    a: "Não. A solicitação pela plataforma Hemocione é gratuita. Os detalhes operacionais do dia da coleta são combinados diretamente com o hemocentro parceiro que aceitar a solicitação.",
  },
  {
    q: "O Hemocione é uma organização confiável?",
    a: "Sim. O Hemocione é uma ONG em atividade desde 2017, com mais de 230 eventos de doação realizados e mais de 10 mil bolsas de sangue coletadas, em parceria com hemocentros de todo o Brasil.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ_ITEMS.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
---

<section class="container">
  <aside>
    <img src={faqWEBP.src} alt="" />
  </aside>
  <aside class="faq">
    <div class="title">
      <h2>Perguntas frequentes</h2>
    </div>
    {
      FAQ_ITEMS.map((item) => (
        <Collapse title={item.q}>
          <p>{item.a}</p>
        </Collapse>
      ))
    }
  </aside>
</section>

<script
  type="application/ld+json"
  set:html={JSON.stringify(faqSchema)}></script>

<style>
  section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 9rem;
  }

  aside {
    flex: 1;
  }

  img {
    background-color: #000;
    width: 100%;
    height: 100%;
  }

  .title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  h2 {
    font-size: 2.25rem;
    font-weight: 500;
  }

  .faq {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (max-width: 768px) {
    section {
      flex-direction: column;
      gap: 2rem;
    }

    img {
      display: none;
    }

    h2 {
      margin-top: 0;
    }
  }
</style>
